PORT=3000
NODE_ENV=development
# Used by `npm start` on the host. Docker Compose does not read this value.
# The app container connects to mongodb://mongo:27017/secure_notes.
MONGODB_URI=mongodb://127.0.0.1:27017/secure_notes
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeAdmin1
